<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Week_2.MainPage"
             BackgroundColor="#F5F5F7">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15" MaximumWidthRequest="600" HorizontalOptions="Center">

            <Border BackgroundColor="#FFFFFF" Stroke="#E0E0E0" StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="New ToDo" FontSize="18" FontAttributes="Bold" TextColor="#111111"/>
                    <Entry x:Name="titleEntry" Placeholder="Title" TextColor="#111111" PlaceholderColor="#888888" BackgroundColor="#FAFABA"/>
                    <Entry x:Name="descriptionEntry" Placeholder="Description" TextColor="#111111" PlaceholderColor="#888888"/>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                        <Label Text="Due:" VerticalOptions="Center" TextColor="#333333"/>
                        <DatePicker x:Name="dueDateEntry" Grid.Column="1" TextColor="#111111" MinimumWidthRequest="140"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                        <Label Text="Urgent Task" VerticalOptions="Center" TextColor="#333333"/>
                        <Switch x:Name="urgentSwitch" Grid.Column="1" OnColor="#111111" ThumbColor="#FFFFFF"/>
                    </Grid>

                    <Button x:Name="addTaskButton" Text="Add Task" Clicked="addTaskButton_Clicked" BackgroundColor="#111111" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="44" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="tasksCollectionView" SelectionMode="Single" SelectionChanged="tasksCollectionView_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,4">
                            <Border BackgroundColor="#FFFFFF" Stroke="#E0E0E0" StrokeThickness="1" Padding="15">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" FontSize="16" TextColor="#111111"/>
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Description}" FontSize="14" TextColor="#666666"/>

                                    <StackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding DueDate, StringFormat='{0:yyyy.MM.dd}'}" FontSize="12" TextColor="#888888" HorizontalOptions="End"/>
                                        <Label Text="{Binding IsUrgent, Converter={StaticResource BoolToUrgentConverter}}" FontSize="12" FontAttributes="Bold" TextColor="#111111" HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsUrgent}" Value="True">
                                                    <Setter Property="TextColor" Value="#D32F2F" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button x:Name="deleteTaskButton" Text="Delete Task" Clicked="deleteTaskButton_Clicked" IsEnabled="False" BackgroundColor="#666666" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="44"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>